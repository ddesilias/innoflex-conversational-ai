# Account recovery only. Other app settings are described in AI-MIGRATION.md and BILLING.md.
# Copy to .env.local for local setup; never commit actual API keys.
PASSWORD_RESET_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
PASSWORD_RESET_ORIGIN=http://localhost:3101
ACCOUNT_STORAGE_NAMESPACE=local

# Signed delivery monitoring; keep disabled until the provider can reach the callback.
SENDGRID_EVENTS_ENABLED=false
SENDGRID_EVENT_PUBLIC_KEY=
EMAIL_MONITORING_TOKEN=
